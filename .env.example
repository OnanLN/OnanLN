# 生产环境务必换成足够长的随机字符串：openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# true：登录页直接显示验证码，不调用短信网关，也不产生短信费
# 正式上线改为 false，并配置下面的 webhook
DEMO_MODE=true

# DEMO_MODE=false 时，发码接口会把 { phone, code, template } POST 到这个地址
# SMS_WEBHOOK_URL=https://example.com/internal/sms
# SMS_WEBHOOK_TOKEN=replace-me
