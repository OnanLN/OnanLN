# 复制为 .env 后按需填写。数据库使用项目内的 SQLite，不需要连接串。

# 验证码哈希胡椒。生产环境请换成一长串随机字符。
CODE_PEPPER=replace-with-a-long-random-string

# 生产环境放在 Nginx 等反向代理后面时设为 true，并让代理写入 X-Real-IP。
# 不要在应用直接暴露到公网时打开，否则客户端可以伪造地址。
TRUST_PROXY=false

# 邮件。不配置时，开发环境会把验证码直接返回给页面；生产环境会拒绝发送。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="位享 <noreply@example.com>"

# 地图开放平台。只填了哪个就用哪个，都填时优先 MAP_PROVIDER。
# MAP_PROVIDER=amap
# AMAP_WEB_KEY=
# BAIDU_MAP_AK=
# TENCENT_MAP_KEY=

# 车场系统回传可用车位的凭证。不配置时接入接口关闭。
# PARKING_INGRESS_TOKEN=
