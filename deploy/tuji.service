[Unit]
Description=途记
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/tuji/.next/standalone
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=TUJI_DATA_DIR=/var/lib/tuji
EnvironmentFile=/etc/tuji.env
ExecStart=/usr/bin/node /var/www/tuji/.next/standalone/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
